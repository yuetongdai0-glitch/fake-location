<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 交给系统绘制一次启动图标，Flutter 首帧前不再叠加第二个标识。 -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/launcher_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/launcher_background</item>
        <item name="android:windowBackground">@color/launcher_background</item>
    </style>
</resources>
